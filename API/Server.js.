const express=require("express");const path=require("path");const app=express();app.use(express.json({limit:"32kb"}));app.use(express.static(path.join(__dirname,"..","public")));
app.post("/api/chat",async(req,res)=>{try{const message=typeof req.body.message==="string"?req.body.message.trim():"";if(!message||message.length>6000)return res.status(400).json({error:"Message empty or too long (max 6000 characters)."});if(!process.env.OPENAI_API_KEY)return res.status(503).json({error:"Server API key not configured."});const r=await fetch("https://api.openai.com/v1/chat/completions",{method:"POST",headers:{"Content-Type":"application/json","Authorization":"Bearer "+process.env.OPENAI_API_KEY},body:JSON.stringify({model:process.env.OPENAI_MODEL||"gpt-4o-mini",messages:[{role:"system",content:"You are DeckAI, a concise and practical mobile cyberdeck assistant."},{role:"user",content:message}],max_tokens:500,temperature:.7})});const d=await r.json();if(!r.ok)return res.status(r.status).json({error:d.error?.message||"AI provider error"});res.json({reply:d.choices?.[0]?.message?.content||"No response"});}catch(e){console.error(e);res.status(500).json({error:"Backend error"});}});app.listen(process.env.PORT||3000,()=>console.log("Cyberdeck server ready"));
